def get_current_active_path():
    if os.path.islink(ACTIVE_SYMLINK):
        try:
            target = os.path.realpath(ACTIVE_SYMLINK)
            if os.path.exists(target):
                return target
        except Exception:
            pass
    return DEFAULT_TARGET

def load_custom_gifs():
    try:
        with open(CUSTOM_LIST) as f:
            return [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return []

def remember_custom_gif(path):
    paths = load_custom_gifs()
    if path not in paths:
        os.makedirs(os.path.dirname(CUSTOM_LIST), exist_ok=True)
        with open(CUSTOM_LIST, "w") as f:
            f.write("\n".join(paths + [path]) + "\n")

def scan_animations():
    results = []
    seen_paths = set()
    active_path = get_current_active_path()

    for folder, category in SEARCH_DIRECTORIES:
        if os.path.isdir(folder):
            for file in sorted(os.listdir(folder)):
                if file.endswith(".gif") and not file.endswith("_thumbnail.gif"):
                    path = os.path.join(folder, file)
                    if path not in seen_paths:
                        seen_paths.add(path)
                        results.append((category, path))

    # GIFs added via Browse live outside the scanned folders
    for path in load_custom_gifs() + [active_path]:
        if path not in seen_paths and os.path.exists(path):
            seen_paths.add(path)
            results.append((CUSTOM_CATEGORY, path))
    return results

def anime_command_for(path):
    """pixel-gif only renders correctly for GIFs drawn for the diagonal LED grid."""
    try:
        with Image.open(path) as im:
            return "pixel-gif" if im.size in NATIVE_SIZES else "gif"
    except Exception:
        return "gif"

# ---- GA402 lid simulation -------------------------------------------------------------
# Geometry and sampling follow asusctl 6.3.8 (rog-anime/src/image.rs and diagonal.rs),
# so the preview shows what asusctl actually sends to each LED.
LED_ROWS = 61                      # physical rows, top to bottom
DIAG_HEIGHT = 39                   # pixel-gif reads a 74x39 diagonal grid on this lid
CM_PER_LED_X, CM_PER_LED_Y = 0.77, 0.283   # LED spacing within a row / between rows

def led_row_start(r):
    """First LED's x position; rows below 11 start further right (diagonal bottom-left cut)."""
    return 0 if r <= 11 else (r + 1) // 2 - 5

def led_row_length(r):
    return 34 if r <= 11 else 39 - r // 2

# Every LED as (row, index in row, x position); odd rows sit half an LED to the left
LEDS = [(r, i, led_row_start(r) + i - 0.5 * (r % 2))
        for r in range(LED_ROWS) for i in range(led_row_length(r))]

def diagonal_pixel(r, i):
    """Image pixel (x, y) that pixel-gif shows on LED i of row r."""
    x0, y0 = ((r + 1) // 2, 5 - r // 2) if r <= 11 else (r - 5, 0)
    return x0 + i, DIAG_HEIGHT - 1 - y0 - i

def scaled_samples(w, h):
    """Per LED, the in-bounds pixel indices asusctl gif averages (scale 1, no rotation)."""
    base = min(35.5 * CM_PER_LED_X / w, LED_ROWS * CM_PER_LED_Y / h)
    sx, sy = CM_PER_LED_X / base, CM_PER_LED_Y / base   # image px per LED step
    du, dv = (-0.5 * sx, 0.5 * sy), (0.5 * sx, 0.5 * sy)
    steps = (0.0, 0.5, 1.0, 1.5)
    result = []
    for r, i, x in LEDS:
        ox, oy = (x - 20) * sx + w / 2, (r - 0.5 - 20) * sy + h / 2   # LED (20, 20) is the center
        samples = []
        for u in steps:
            for v in steps:
                px, py = int(ox + u * du[0] + v * dv[0]), int(oy + u * du[1] + v * dv[1])
                if 0 <= px < w and 0 <= py < h:
                    samples.append(px + py * w)
        result.append(samples)
    return result

class LedSampler:
    """Turns RGBA frames of one GIF into per-LED brightness (bytes, one per LED)."""
    def __init__(self, size):
        w, h = size
        self.native = size in NATIVE_SIZES
        if self.native:
            # pixel-gif uses the red channel of opaque pixels
            self.offsets = []
            for r, i, _ in LEDS:
                x, y = diagonal_pixel(r, i)
                self.offsets.append((x + y * w) * 4 if 0 <= x < w and 0 <= y < h else -1)
        else:
            self.samples = [[p * 4 for p in s] for s in scaled_samples(w, h)]

    def sample(self, data):
        if self.native:
            return bytes(data[o] if o >= 0 and data[o + 3] == 255 else 0 for o in self.offsets)
        out = bytearray(len(self.samples))
        for n, samples in enumerate(self.samples):
            if not samples:
                continue
            total = lit = 0
            for o in samples:
                if data[o + 3] == 255:   # asusctl ignores pixels that aren't fully opaque
                    total += (data[o] + data[o + 1] + data[o + 2]) // 3
                    lit += 1
            k = len(samples)
            out[n] = int((total / k) * (lit / k))
        return bytes(out)

class LidRenderer:
    """Draws per-LED brightness as round dots in the lid's physical layout.

    Rows of each parity (even/odd) form a regular grid, so each is drawn by enlarging a
    tiny one-pixel-per-LED image and masking it with pre-drawn dots. That keeps the
    per-frame work in Pillow's C code instead of drawing 1700 circles in Python.
    """
    CELL_W, ROW_H = 16, 6          # px per LED horizontally / per row (~1.4x the preview size)
    DOT_RADIUS = 4.5
    OFF_LEVEL = 26                 # unlit LEDs stay faintly visible to show the lid's shape

    def __init__(self):
        cw, rh = self.CELL_W, self.ROW_H
        self.size = (35 * cw, (LED_ROWS + 1) * rh)
        self.lut = bytes(self.OFF_LEVEL + v * (255 - self.OFF_LEVEL) // 255 for v in range(256))
        self.parities = []
        for p in (0, 1):
            ncols, nrows = (34, 31) if p == 0 else (35, 30)
            index = [-1] * (ncols * nrows)   # grid cell -> LED number
            ss = 4                           # supersample the dots for smooth edges
            mask = Image.new("L", (self.size[0] * ss, self.size[1] * ss), 0)
            draw = ImageDraw.Draw(mask)
            for n, (r, i, x) in enumerate(LEDS):
                if r % 2 != p:
                    continue
                index[(r // 2) * ncols + int(x + 0.5 * p)] = n
                cx, cy, rad = (x + 1) * cw * ss, (r + 1) * rh * ss, self.DOT_RADIUS * ss
                draw.ellipse((cx - rad, cy - rad, cx + rad, cy + rad), fill=255)
            mask = mask.resize(self.size, Image.Resampling.BOX)
            offset = (cw // 2, 0) if p == 0 else (0, rh)
            self.parities.append((ncols, nrows, index, mask, offset))

    def render(self, levels):
        """Greyscale PIL image of the lid, as seen from outside, for one frame of per-LED levels.

        asusctl numbers rows from the inside of the lid, so the result is flipped top to
        bottom; that is the orientation in which ASUS's stock text animations read correctly.
        """
        lut = self.lut
        layers = []
        for ncols, nrows, index, mask, offset in self.parities:
            grid = bytes(lut[levels[n]] if n >= 0 else 0 for n in index)
            small = Image.frombytes("L", (ncols, nrows), grid)
            big = small.resize((ncols * self.CELL_W, nrows * 2 * self.ROW_H), Image.Resampling.NEAREST)
            canvas = Image.new("L", self.size, 0)
            canvas.paste(big, offset)
            layers.append(ImageChops.multiply(canvas, mask))
        return ImageOps.flip(ImageChops.lighter(*layers))

    def texture(self, levels):
        img = self.render(levels)
        return Gdk.MemoryTexture.new(img.width, img.height, Gdk.MemoryFormat.G8,
                                     GLib.Bytes.new(img.tobytes()), img.width)

def run_cmd(args):
    """Run a command, returning (ok, error message)."""
    try:
        res = subprocess.run(args, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)
    # asusctl reports some failures with exit code 0, so also look for its "Error:" line
    err = find_error(res.stdout + res.stderr)
    if res.returncode != 0 or err:
        return False, err or f"exit code {res.returncode}"
    return True, ""

def find_error(output):
    for line in output.splitlines():
        if line.startswith("Error"):
            return line.split(":", 1)[-1].strip()
    return ""

def service_props():
    res = subprocess.run(
        ["systemctl", "--user", "show", SERVICE, "-p", "ActiveState,SubState,NRestarts,ConditionResult"],
        capture_output=True, text=True
    )
    return dict(line.split("=", 1) for line in res.stdout.splitlines() if "=" in line)

def apply_animation(path):
    """Blocking: make `path` the running animation. Returns (error, (restarts, started_at))."""
    ok, err = run_cmd(["asusctl", "anime", "--enable-display", "true"])
    if not ok:
        return f"Couldn't enable the lid display: {err}", None

    # 1. Update symlink ~/.config/anime-matrix/active.gif
    os.makedirs(os.path.dirname(ACTIVE_SYMLINK), exist_ok=True)
    if os.path.islink(ACTIVE_SYMLINK) or os.path.exists(ACTIVE_SYMLINK):
        os.remove(ACTIVE_SYMLINK)
    os.symlink(path, ACTIVE_SYMLINK)

    # 2. Tell the service whether to play it pixel-perfect or scaled
    with open(MODE_ENV, "w") as f:
        f.write(f"ANIME_CMD={anime_command_for(path)}\n")

    # 3. Re-enable (Turn Off disables it) and restart the background service
    started_at = time.time()
    ok, err = run_cmd(["systemctl", "--user", "enable", SERVICE])
    if ok:
        ok, err = run_cmd(["systemctl", "--user", "restart", SERVICE])
    if not ok:
        return f"Couldn't restart the service: {err}", None
    return None, (service_props().get("NRestarts", "0"), started_at)

def turn_off_matrix():
    """Blocking: stop the animation and keep it off across reboots. Returns an error or None."""
    for args in (["systemctl", "--user", "disable", "--now", SERVICE],
                 ["asusctl", "anime", "--clear"],
                 ["asusctl", "anime", "--enable-display", "false"]):
        ok, err = run_cmd(args)
        if not ok:
            return err
    return None

class PixelPaintable(GObject.Object, Gdk.Paintable):
    """Draws a texture centered and fitted; enlarges by whole numbers with sharp pixels."""
    def __init__(self):
        super().__init__()
        self.texture = None

    def set_texture(self, texture):
        self.texture = texture
        self.invalidate_contents()

    def do_snapshot(self, snapshot, width, height):
        if self.texture is None:
            return
        tw, th = self.texture.get_width(), self.texture.get_height()
        scale = min(width / tw, height / th)
        if scale >= 1:
            scale, filt = math.floor(scale), Gsk.ScalingFilter.NEAREST
        else:
            filt = Gsk.ScalingFilter.TRILINEAR
        w, h = tw * scale, th * scale
        rect = Graphene.Rect().init((width - w) / 2, (height - h) / 2, w, h)
        snapshot.append_scaled_texture(self.texture, filt, rect)

def make_texture(w, h, data):
    return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8A8, GLib.Bytes.new(data), w * 4)

def decode_thumbnail(path):
    """Frames as (w, h, rgba bytes, duration ms), shrunk to THUMB_SIZE and capped in count."""
    frames = []
    with Image.open(path) as im:
        step = math.ceil(getattr(im, "n_frames", 1) / THUMB_MAX_FRAMES)
        shrink = im.width > THUMB_SIZE[0] or im.height > THUMB_SIZE[1]
        for i, frame in enumerate(ImageSequence.Iterator(im)):
            if i % step == 0:
                rgba = frame.convert("RGBA")
                if shrink:
                    rgba.thumbnail(THUMB_SIZE, Image.Resampling.LANCZOS)
                frames.append([rgba.width, rgba.height, rgba.tobytes(), 0])
            # a kept frame also lasts as long as the frames skipped after it
            frames[-1][3] += max(frame.info.get("duration", 40), 20)
    return frames

class ThumbnailLoader:
    """Decodes thumbnails one at a time on a background thread, on request."""
    def __init__(self, on_ready):
        self.on_ready = on_ready  # called on the UI thread as on_ready(path, frames)
        self.requested = set()
        self.jobs = queue.Queue()
        threading.Thread(target=self._work, daemon=True).start()

    def request(self, path):
        if path not in self.requested:
            self.requested.add(path)
            self.jobs.put(path)

    def _work(self):
        while True:
            path = self.jobs.get()
            try:
                frames = decode_thumbnail(path)
            except Exception as e:
                print(f"Error loading thumbnail for {path}: {e}")
                frames = []
            GLib.idle_add(self._deliver, path, frames)

    def _deliver(self, path, frames):
        self.on_ready(path, [(make_texture(w, h, data), dur) for w, h, data, dur in frames])
        return False

class AnimationTile(Gtk.FlowBoxChild):
    """One grid entry: an animated thumbnail with the file name under it."""
    def __init__(self, category, path):
        super().__init__()
        self.category = category
        self.path = path
        self.name = os.path.basename(path)
        self.search_text = f"{self.name} {category}".lower()
        self.frames = None  # None until the loader delivers them
        self.frame_idx = 0
        self.next_change = 0

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.paintable = PixelPaintable()
        art = Gtk.Picture(paintable=self.paintable, can_shrink=True)
        art.set_size_request(*THUMB_SIZE)
        art.add_css_class("thumb-art")
        box.append(art)
        label = Gtk.Label(label=os.path.splitext(self.name)[0], max_width_chars=16,
                          ellipsize=Pango.EllipsizeMode.END)
        label.add_css_class("path-label")
        box.append(label)
        self.set_child(box)
        self.set_tooltip_text(f"{self.name}\n{category}")
        self.add_css_class("anim-tile")

    def set_frames(self, frames):
        self.frames = frames
        self.frame_idx = 0
        self.next_change = 0
        if frames:
            self.paintable.set_texture(frames[0][0])

    def advance(self, now_ms):
        if not self.frames or len(self.frames) < 2 or now_ms < self.next_change:
            return
        self.frame_idx = (self.frame_idx + 1) % len(self.frames)
        tex, dur = self.frames[self.frame_idx]
        self.paintable.set_texture(tex)
        self.next_change = now_ms + dur

class GifPlayer:
    """Renders and loops animated GIFs frame-by-frame inside Gtk.Picture."""
    def __init__(self, picture_widget, is_paused=lambda: False):
        self.is_paused = is_paused  # checked each frame; paused frames don't advance
        self.paintable = PixelPaintable()
        picture_widget.set_paintable(self.paintable)
        self.frames = []        # (plain texture, per-LED levels, duration ms)
        self.frame_idx = 0
        self.shown_idx = 0
        self.lid_view = True    # draw as the lid's LEDs instead of the raw GIF
        self.lid = None         # LidRenderer, built on first use
        self.timer_id = None
        self.load_token = 0  # bumped per load so a slow decode can't overwrite a newer pick

    def stop(self):
        self.load_token += 1
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = None

    def load(self, path, on_loaded):
        """Decode `path` in a background thread, then start playback and call on_loaded(info)."""
        self.stop()
        token = self.load_token
        threading.Thread(target=self._decode, args=(path, token, on_loaded), daemon=True).start()

    def _decode(self, path, token, on_loaded):
        frames, info_str = [], None
        try:
            with Image.open(path) as im:
                sampler = LedSampler(im.size)
                info_str = f"{im.size[0]} × {im.size[1]} px"
                if getattr(im, "is_animated", False) and getattr(im, "n_frames", 1) > 1:
                    info_str += f" • {im.n_frames} frames"
                info_str += " • pixel-perfect" if sampler.native else " • scaled to fit"
                for frame in ImageSequence.Iterator(im):
                    if token != self.load_token:
                        return  # a different GIF was picked meanwhile
                    rgba = frame.convert("RGBA")
                    data = rgba.tobytes()
                    dur = frame.info.get("duration", 40)
                    frames.append((rgba.width, rgba.height, data, sampler.sample(data), max(dur, 20)))
        except Exception as e:
            print(f"Error loading GIF preview for {path}: {e}")
            frames, info_str = [], None
        GLib.idle_add(self._show, token, frames, info_str, on_loaded)

    def _show(self, token, frames, info_str, on_loaded):
        if token != self.load_token:
            return False
        self.frames = [(make_texture(w, h, data), levels, dur) for w, h, data, levels, dur in frames]
        self.frame_idx = 0
        if self.frames:
            self.next_frame(first=True)
        on_loaded(info_str)
        return False

    def set_lid_view(self, on):
        self.lid_view = on
        if self.frames:
            self.paint(self.shown_idx)

    def paint(self, idx):
        tex, levels, _ = self.frames[idx]
        if self.lid_view:
            if self.lid is None:
                self.lid = LidRenderer()
            tex = self.lid.texture(levels)
        self.paintable.set_texture(tex)
        self.shown_idx = idx

    def next_frame(self, first=False):
        if not self.frames:
            return False
        if self.is_paused() and not first:  # always show the first frame
            self.timer_id = GLib.timeout_add(250, self.next_frame)
            return False
        self.paint(self.frame_idx)
        delay = self.frames[self.frame_idx][2]
        if len(self.frames) > 1:
            self.frame_idx = (self.frame_idx + 1) % len(self.frames)
            self.timer_id = GLib.timeout_add(delay, self.next_frame)
        return False

