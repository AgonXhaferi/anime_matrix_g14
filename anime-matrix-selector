class AniMeMatrixApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.rog.animematrix.selector", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.animations, self.default_idx = scan_animations()
        self.gif_player = None

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, title="AniMe Matrix Selector")
        win.set_default_size(560, 520)
        win.set_resizable(False)

        # Apply CSS
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(CSS_STYLING.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        main_box.set_margin_top(18)
        main_box.set_margin_bottom(18)
        main_box.set_margin_start(20)
        main_box.set_margin_end(20)
        win.set_child(main_box)

        # Header Title
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        vbox_titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        h_title = Gtk.Label(label="AniMe Matrix Animation Selector", xalign=0)
        h_title.add_css_class("title-label")
        h_subtitle = Gtk.Label(label="ROG Zephyrus G14 AniMe Matrix Manager", xalign=0)
        h_subtitle.add_css_class("path-label")
        vbox_titles.append(h_title)
        vbox_titles.append(h_subtitle)
        title_box.append(vbox_titles)

        lbl_spacer_h = Gtk.Label()
        lbl_spacer_h.set_hexpand(True)
        title_box.append(lbl_spacer_h)

        self.lbl_badge = Gtk.Label(label="● Active in Background")
        self.lbl_badge.add_css_class("active-badge")
        title_box.append(self.lbl_badge)

        main_box.append(title_box)

        # Dropdown selection section
        select_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl_dropdown = Gtk.Label(label="Select Animation:", xalign=0)
        lbl_dropdown.add_css_class("heading")

        labels = [item[0] for item in self.animations]
        self.dropdown = Gtk.DropDown.new_from_strings(labels)
        self.dropdown.set_selected(self.default_idx)
        self.dropdown.connect("notify::selected", self.on_dropdown_changed)

        select_box.append(lbl_dropdown)
        select_box.append(self.dropdown)
        main_box.append(select_box)

        # Preview Card
        self.preview_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.preview_card.add_css_class("preview-card")

        self.picture = Gtk.Picture()
        self.picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.picture.set_can_shrink(True)
        self.picture.set_size_request(320, 180)
        self.preview_card.append(self.picture)

        self.gif_player = GifPlayer(self.picture)

        self.lbl_current_path = Gtk.Label(xalign=0.5)
        self.lbl_current_path.add_css_class("path-label")
        self.preview_card.append(self.lbl_current_path)

        main_box.append(self.preview_card)

        # Status Label
        self.lbl_status = Gtk.Label(label="", xalign=0.5)
        main_box.append(self.lbl_status)

        # Action Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_homogeneous(True)

        self.btn_apply = Gtk.Button(label="★ Set as Main Running Animation")
        self.btn_apply.add_css_class("suggested-action")
        self.btn_apply.connect("clicked", self.on_apply_clicked)
        btn_box.append(self.btn_apply)

        self.btn_off = Gtk.Button(label="⏹ Turn Off Lid Display")
        self.btn_off.connect("clicked", self.on_turn_off_clicked)
        btn_box.append(self.btn_off)

        main_box.append(btn_box)

        # Bottom secondary tools
        bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        btn_open_folder = Gtk.Button(label="📁 Open Folder")
        btn_open_folder.connect("clicked", self.on_open_folder_clicked)
        bottom_box.append(btn_open_folder)

        btn_add_custom = Gtk.Button(label="➕ Browse Custom GIF...")
        btn_add_custom.connect("clicked", self.on_add_custom_clicked)
        bottom_box.append(btn_add_custom)

        main_box.append(bottom_box)

        # Start initial preview
        self.update_preview()
        self.check_service_status()

        win.connect("destroy", self.on_window_destroy)
        win.present()

    def get_selected_path(self):
        idx = self.dropdown.get_selected()
        if 0 <= idx < len(self.animations):
            return self.animations[idx][1]
        return None

    def update_preview(self):
        path = self.get_selected_path()
        if path and os.path.exists(path):
            fname = os.path.basename(path)
            self.lbl_current_path.set_text(f"{fname}  •  loading…")
            self.gif_player.load(path, lambda info: self.lbl_current_path.set_text(
                f"{fname}  •  {info}" if info else fname))
        else:
            self.gif_player.stop()
            self.lbl_current_path.set_text("File not found")

    def check_service_status(self):
        res = subprocess.run(
            ["systemctl", "--user", "is-active", "anime-matrix.service"],
            capture_output=True, text=True
        )
        if os.path.islink(ACTIVE_SYMLINK) and not os.path.exists(ACTIVE_SYMLINK):
            self.lbl_badge.set_text("⚠ Active GIF missing, pick another")
        elif res.stdout.strip() == "active":
            active_file = os.path.basename(get_current_active_path())
            self.lbl_badge.set_visible(True)
            self.lbl_badge.set_text(f"● Active: {active_file}")
        else:
            self.lbl_badge.set_text("○ Matrix Inactive")

    def on_dropdown_changed(self, dropdown, pspec):
        self.update_preview()
        self.lbl_status.set_text("")

    def on_apply_clicked(self, button):
        path = self.get_selected_path()
        if not path or not os.path.exists(path):
            self.set_status("Selected file does not exist", "status-error")
            return

        filename = os.path.basename(path)
        self.set_busy(True)
        self.set_status(f"Starting '{filename}'…", "status-info")
        self.run_in_background(lambda: apply_animation(path),
                               lambda result: self.on_apply_done(filename, result))

    def on_apply_done(self, filename, result):
        err, check = result
        if err:
            self.set_status(err, "status-error")
            self.set_busy(False)
            self.check_service_status()
            return
        # asusctl can fail a moment after starting, so confirm it is still running
        GLib.timeout_add(2500, self.verify_playing, filename, *check)

    def verify_playing(self, filename, restarts_before, started_at):
        props = service_props()
        if props.get("SubState") == "running" and props.get("NRestarts", "0") == restarts_before:
            self.set_status(f"✓ '{filename}' is now active & playing on your lid!", "status-success")
        elif props.get("ConditionResult") == "no":
            self.set_status(f"'{filename}' failed to play: the GIF file is missing", "status-error")
        else:
            # Only look at this attempt's log lines, not errors from earlier runs
            res = subprocess.run(
                ["journalctl", "--user", "-u", SERVICE, "--since", f"@{int(started_at)}",
                 "-o", "cat", "--no-pager"],
                capture_output=True, text=True
            )
            errors = [find_error(line) for line in res.stdout.splitlines() if find_error(line)]
            detail = errors[-1] if errors else props.get("ActiveState", "not running")
            self.set_status(f"'{filename}' failed to play: {detail}", "status-error")
        self.set_busy(False)
        self.check_service_status()
        return False

    def on_turn_off_clicked(self, button):
        self.set_busy(True)
        self.set_status("Turning off…", "status-info")
        self.run_in_background(turn_off_matrix, self.on_turn_off_done)

    def on_turn_off_done(self, err):
        if err:
            self.set_status(f"Couldn't turn off the lid display: {err}", "status-error")
        else:
            self.set_status("Matrix display turned off (stays off until you pick an animation)", "status-info")
        self.set_busy(False)
        self.check_service_status()

    def run_in_background(self, work, done):
        """Run blocking `work` off the UI thread so the window stays responsive, then done(result)."""
        def worker():
            result = work()
            GLib.idle_add(lambda: done(result) and False)
        threading.Thread(target=worker, daemon=True).start()

    def set_busy(self, busy):
        self.btn_apply.set_sensitive(not busy)
        self.btn_off.set_sensitive(not busy)

    def on_open_folder_clicked(self, button):
        path = self.get_selected_path()
        if path:
            folder = os.path.dirname(path)
            subprocess.Popen(["xdg-open", folder])

    def on_add_custom_clicked(self, button):
        dialog = Gtk.FileDialog()
        dialog.set_title("Select a GIF for AniMe Matrix")
        gif_filter = Gtk.FileFilter()
        gif_filter.set_name("GIF Animations")
        gif_filter.add_pattern("*.gif")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(gif_filter)
        dialog.set_filters(filters)

        def on_file_selected(dialog, result):
            try:
                gfile = dialog.open_finish(result)
                if gfile:
                    path = gfile.get_path()
                    if path and path.endswith(".gif"):
                        paths = [item[1] for item in self.animations]
                        if path in paths:
                            self.dropdown.set_selected(paths.index(path))
                            return
                        remember_custom_gif(path)
                        name = f"[Custom]  {os.path.basename(path)}"
                        self.animations.append((name, path))
                        labels = [item[0] for item in self.animations]
                        model = Gtk.StringList.new(labels)
                        self.dropdown.set_model(model)
                        self.dropdown.set_selected(len(self.animations) - 1)
                        self.update_preview()
                        self.set_status(f"Added '{os.path.basename(path)}'", "status-info")
            except Exception:
                pass

        dialog.open(None, None, on_file_selected)

    def set_status(self, text, css_class):
        self.lbl_status.set_text(text)
        self.lbl_status.remove_css_class("status-success")
        self.lbl_status.remove_css_class("status-error")
        self.lbl_status.remove_css_class("status-info")
        self.lbl_status.add_css_class(css_class)

    def on_window_destroy(self, window):
        if self.gif_player:
            self.gif_player.stop()

if __name__ == "__main__":
    app = AniMeMatrixApp()
    sys.exit(app.run(sys.argv))
