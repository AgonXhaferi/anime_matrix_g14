#!/usr/bin/env python3
"""Launcher for the AniMe Matrix Selector; the app itself is the anime_matrix_selector package.

It is usually run through a symlink, so it finds the package next to its real path.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from anime_matrix_selector.__main__ import main  # noqa: E402

sys.exit(main())
