DEFAULT_TARGET = "/usr/share/asusd/anime/asus/rog/Sunset.gif"
ACTIVE_SYMLINK = os.path.expanduser("~/.config/anime-matrix/active.gif")

SEARCH_DIRECTORIES = [
    ("/usr/share/asusd/anime/asus/rog", "ROG (Stock)"),
    ("/usr/share/asusd/anime/asus/gaming", "Gaming (Stock)"),
    ("/usr/share/asusd/anime/asus/music", "Music (Stock)"),
    ("/usr/share/asusd/anime/asus/trend", "Trend (Stock)"),
    ("/usr/share/asusd/anime/asus/festive", "Festive (Stock)"),
    ("/usr/share/asusd/anime/custom", "Custom (Stock)"),
    (os.path.expanduser("~/Pictures/ArmouryCrate_GIFs/AniMe_Matrix_Normal"), "Armoury Crate Normal"),
    (os.path.expanduser("~/Pictures/ArmouryCrate_GIFs/AniMe_Matrix_Patterns"), "Armoury Crate Patterns"),
    (os.path.expanduser("~/Pictures/ArmouryCrate_GIFs/AniMe_Matrix_Alan_Walker"), "Alan Walker Collection"),
]

def get_current_active_path():
    if os.path.islink(ACTIVE_SYMLINK):
        try:
            target = os.path.realpath(ACTIVE_SYMLINK)
            if os.path.exists(target):
                return target
        except Exception:
            pass
    return DEFAULT_TARGET

def scan_animations():
    results = []
    seen_paths = set()
    active_path = get_current_active_path()

    for folder, category in SEARCH_DIRECTORIES:
        if os.path.isdir(folder):
            for file in sorted(os.listdir(folder)):
                if file.endswith(".gif") and not file.endswith("_thumbnail.gif"):
                    path = os.path.join(folder, file)
                    if path not in seen_paths:
                        seen_paths.add(path)
                        display_name = f"[{category}]  {file}"
                        results.append((display_name, path))

    # Ensure active_path or DEFAULT_TARGET is prioritized at index 0
    target_idx = 0
    for idx, (name, path) in enumerate(results):
        if path == active_path or path == DEFAULT_TARGET or os.path.basename(path) == "Sunset.gif":
            item = results.pop(idx)
            results.insert(0, item)
            break

    return results, 0

class GifPlayer:
    """Renders and loops animated GIFs frame-by-frame inside Gtk.Picture."""
    def __init__(self, picture_widget):
        self.picture = picture_widget
        self.frames = []
        self.frame_idx = 0
        self.timer_id = None

    def stop(self):
        if self.timer_id:
            GLib.source_remove(self.timer_id)
            self.timer_id = None

    def load(self, path):
        self.stop()
        if not path or not os.path.exists(path):
            return None

        try:
            im = Image.open(path)
            self.frames = []
            info_str = f"{im.size[0]} × {im.size[1]} px"

            # Check if animated
            is_anim = getattr(im, "is_animated", False) and getattr(im, "n_frames", 1) > 1
            if is_anim:
                info_str += f" • {im.n_frames} frames"
                for frame in ImageSequence.Iterator(im):
                    rgba = frame.convert("RGBA")
                    raw_bytes = rgba.tobytes()
                    glib_bytes = GLib.Bytes.new(raw_bytes)
                    tex = Gdk.MemoryTexture.new(
                        rgba.width, rgba.height,
                        Gdk.MemoryFormat.R8G8B8A8,
                        glib_bytes, rgba.width * 4
                    )
                    dur = frame.info.get("duration", 40)
                    self.frames.append((tex, max(dur, 20)))
            else:
                rgba = im.convert("RGBA")
                raw_bytes = rgba.tobytes()
                glib_bytes = GLib.Bytes.new(raw_bytes)
                tex = Gdk.MemoryTexture.new(
                    rgba.width, rgba.height,
                    Gdk.MemoryFormat.R8G8B8A8,
                    glib_bytes, rgba.width * 4
                )
                self.frames.append((tex, 1000))

            self.frame_idx = 0
            if self.frames:
                self.next_frame()
            return info_str
        except Exception as e:
            print(f"Error loading GIF preview for {path}: {e}")
            return None

    def next_frame(self):
        if not self.frames:
            return False
        tex, delay = self.frames[self.frame_idx]
        self.picture.set_paintable(tex)
        if len(self.frames) > 1:
            self.frame_idx = (self.frame_idx + 1) % len(self.frames)
            self.timer_id = GLib.timeout_add(delay, self.next_frame)
        return False

