    def build_library(self, win):
        """Search box above a scrollable grid of animated thumbnails, grouped by category."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, hexpand=True)
        self.search = Gtk.SearchEntry(placeholder_text="Search animations (just start typing)")
        self.search.set_key_capture_widget(win)
        self.search.connect("search-changed", self.on_search_changed)
        box.append(self.search)

        self.scroller = Gtk.ScrolledWindow(vexpand=True)
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        box.append(self.scroller)

        self.sections_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.scroller.set_child(self.sections_box)
        self.lbl_no_results = Gtk.Label(label="No animations match", visible=False, margin_top=40)
        self.lbl_no_results.add_css_class("dim-label")
        self.sections_box.append(self.lbl_no_results)

        for category in [c for _, c in SEARCH_DIRECTORIES] + [CUSTOM_CATEGORY]:
            self.add_section(category)
        for category, path in self.animations:
            self.add_tile(category, path)
        self.thumbs = ThumbnailLoader(self.on_thumbnail_ready)
        self.refresh_sections()
        return box

    def add_section(self, category):
        heading = Gtk.Label(label=category, xalign=0)
        heading.add_css_class("section-heading")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, homogeneous=True,
                           max_children_per_line=12, row_spacing=4, column_spacing=4,
                           valign=Gtk.Align.START)
        flow.set_filter_func(self.tile_matches)
        flow.connect("selected-children-changed", self.on_tile_selected)
        self.sections_box.append(heading)
        self.sections_box.append(flow)
        self.sections.append((category, heading, flow))

    def add_tile(self, category, path):
        tile = AnimationTile(category, path)
        self.tiles[path] = tile
        for cat, heading, flow in self.sections:
            if cat == category:
                flow.append(tile)
        return tile

    def tile_matches(self, tile):
        query = self.search.get_text().strip().lower()
        return all(word in tile.search_text for word in query.split())

    def refresh_sections(self):
        """Hide categories with nothing to show, and say so when nothing matches at all."""
        any_shown = False
        for cat, heading, flow in self.sections:
            shown = any(self.tile_matches(t) for t in self.tiles.values() if t.category == cat)
            heading.set_visible(shown)
            flow.set_visible(shown)
            any_shown = any_shown or shown
        self.lbl_no_results.set_visible(not any_shown)

    def on_search_changed(self, entry):
        for _, _, flow in self.sections:
            flow.invalidate_filter()
        self.refresh_sections()

    def on_tile_selected(self, flow):
        if self.syncing_selection:
            return
        selected = flow.get_selected_children()
        if not selected:
            return
        # Each category is its own grid, so clear the selection in the others
        self.syncing_selection = True
        for _, _, other in self.sections:
            if other is not flow:
                other.unselect_all()
        self.syncing_selection = False
        if selected[0].path != self.selected_path:
            self.selected_path = selected[0].path
            self.update_preview()
            self.lbl_status.set_text("")

    def select_tile(self, tile):
        tile.get_parent().select_child(tile)  # triggers on_tile_selected

    def reveal_tile(self, tile):
        """Select `tile` and scroll it into view; returns False once done (tick callback)."""
        ok, rect = tile.compute_bounds(self.sections_box)
        if not ok or self.scroller.get_height() == 0 or rect.origin.y != self.last_tile_y:
            # not laid out yet, or still moving while the window settles on its size
            self.last_tile_y = rect.origin.y if ok else None
            return True
        self.syncing_selection = True
        tile.get_parent().select_child(tile)
        self.syncing_selection = False
        # Focus first: focusing scrolls on its own, and our position should win
        tile.grab_focus()
        heading_room = 40  # keep the category heading visible above it
        self.scroller.get_vadjustment().set_value(max(0, rect.origin.y - heading_room))
        return False

    def tick_thumbnails(self):
        """Animate the thumbnails currently in view, and request ones not loaded yet."""
        if not self.window.is_active():
            return True  # save battery: thumbnails pause while you're in another window
        now = GLib.get_monotonic_time() // 1000
        view_height = self.scroller.get_height()
        for tile in self.tiles.values():
            if not tile.is_drawable():  # filtered out, hidden section or window minimised
                continue
            ok, rect = tile.compute_bounds(self.scroller)
            if not ok or rect.origin.y + rect.size.height < 0 or rect.origin.y > view_height:
                continue
            if tile.frames is None:
                self.thumbs.request(tile.path)
            else:
                tile.advance(now)
        return True

    def on_thumbnail_ready(self, path, frames):
        if path in self.tiles:
            self.tiles[path].set_frames(frames)

    def mark_active_tile(self, active_path):
        for path, tile in self.tiles.items():
            if path == active_path:
                tile.add_css_class("active-anim")
            else:
                tile.remove_css_class("active-anim")

    def get_selected_path(self):
        return self.selected_path

    def update_preview(self):
        path = self.get_selected_path()
        if path and os.path.exists(path):
            fname = os.path.basename(path)
            self.lbl_current_path.set_text(f"{fname}  •  loading…")
            self.gif_player.load(path, lambda info: self.lbl_current_path.set_text(
                f"{fname}  •  {info}" if info else fname))
        else:
            self.gif_player.stop()
            self.lbl_current_path.set_text("File not found")

    def check_service_status(self):
        res = subprocess.run(
            ["systemctl", "--user", "is-active", "anime-matrix.service"],
            capture_output=True, text=True
        )
        playing = res.stdout.strip() == "active"
        if os.path.islink(ACTIVE_SYMLINK) and not os.path.exists(ACTIVE_SYMLINK):
            self.lbl_badge.set_text("⚠ Active GIF missing, pick another")
        elif playing:
            active_file = os.path.basename(get_current_active_path())
            self.lbl_badge.set_visible(True)
            self.lbl_badge.set_text(f"● Active: {active_file}")
        else:
            self.lbl_badge.set_text("○ Matrix Inactive")
        self.mark_active_tile(get_current_active_path() if playing else None)

    def on_apply_clicked(self, button):
        path = self.get_selected_path()
        if not path or not os.path.exists(path):
            self.set_status("Selected file does not exist", "status-error")
            return

        filename = os.path.basename(path)
        self.set_busy(True)
        self.set_status(f"Starting '{filename}'…", "status-info")
        self.run_in_background(lambda: apply_animation(path),
                               lambda result: self.on_apply_done(filename, result))

    def on_apply_done(self, filename, result):
        err, check = result
        if err:
            self.set_status(err, "status-error")
            self.set_busy(False)
            self.check_service_status()
            return
        # asusctl can fail a moment after starting, so confirm it is still running
        GLib.timeout_add(2500, self.verify_playing, filename, *check)

    def verify_playing(self, filename, restarts_before, started_at):
        props = service_props()
        if props.get("SubState") == "running" and props.get("NRestarts", "0") == restarts_before:
            self.set_status(f"✓ '{filename}' is now active & playing on your lid!", "status-success")
        elif props.get("ConditionResult") == "no":
            self.set_status(f"'{filename}' failed to play: the GIF file is missing", "status-error")
        else:
            # Only look at this attempt's log lines, not errors from earlier runs
            res = subprocess.run(
                ["journalctl", "--user", "-u", SERVICE, "--since", f"@{int(started_at)}",
                 "-o", "cat", "--no-pager"],
                capture_output=True, text=True
            )
            errors = [find_error(line) for line in res.stdout.splitlines() if find_error(line)]
            detail = errors[-1] if errors else props.get("ActiveState", "not running")
            self.set_status(f"'{filename}' failed to play: {detail}", "status-error")
        self.set_busy(False)
        self.check_service_status()
        return False

    def on_turn_off_clicked(self, button):
        self.set_busy(True)
        self.set_status("Turning off…", "status-info")
        self.run_in_background(turn_off_matrix, self.on_turn_off_done)

    def on_turn_off_done(self, err):
        if err:
            self.set_status(f"Couldn't turn off the lid display: {err}", "status-error")
        else:
            self.set_status("Matrix display turned off (stays off until you pick an animation)", "status-info")
        self.set_busy(False)
        self.check_service_status()

    def run_in_background(self, work, done):
        """Run blocking `work` off the UI thread so the window stays responsive, then done(result)."""
        def worker():
            result = work()
            GLib.idle_add(lambda: done(result) and False)
        threading.Thread(target=worker, daemon=True).start()

    def set_busy(self, busy):
        self.btn_apply.set_sensitive(not busy)
        self.btn_off.set_sensitive(not busy)

    def on_open_folder_clicked(self, button):
        path = self.get_selected_path()
        if path:
            folder = os.path.dirname(path)
            subprocess.Popen(["xdg-open", folder])

    def on_add_custom_clicked(self, button):
        dialog = Gtk.FileDialog()
        dialog.set_title("Select a GIF for AniMe Matrix")
        gif_filter = Gtk.FileFilter()
        gif_filter.set_name("GIF Animations")
        gif_filter.add_pattern("*.gif")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(gif_filter)
        dialog.set_filters(filters)

        def on_file_selected(dialog, result):
            try:
                gfile = dialog.open_finish(result)
                if gfile:
                    path = gfile.get_path()
                    if path and path.endswith(".gif"):
                        tile = self.tiles.get(path)
                        is_new = tile is None
                        if is_new:
                            remember_custom_gif(path)
                            self.animations.append((CUSTOM_CATEGORY, path))
                            tile = self.add_tile(CUSTOM_CATEGORY, path)
                        self.search.set_text("")  # make sure the new tile isn't filtered out
                        self.refresh_sections()
                        self.select_tile(tile)
                        if is_new:
                            self.set_status(f"Added '{os.path.basename(path)}'", "status-info")
                        GLib.timeout_add(100, lambda: self.scroller.get_child().scroll_to(tile, None) and False)
            except Exception:
                pass

        dialog.open(None, None, on_file_selected)

    def build_settings_card(self):
        """Brightness and power options, mirrored live from asusd."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class("settings-card")

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl = Gtk.Label(label="Display Settings", xalign=0, hexpand=True)
        lbl.add_css_class("heading")
        header.append(lbl)
        self.lbl_settings_note = Gtk.Label(label="Connecting to asusd…")
        self.lbl_settings_note.add_css_class("path-label")
        header.append(self.lbl_settings_note)
        card.append(header)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.append(Gtk.Label(label="Brightness", xalign=0, hexpand=True))
        self.dd_brightness = Gtk.DropDown.new_from_strings(BRIGHTNESS_LEVELS)
        self.dd_brightness.connect("notify::selected", self.on_brightness_changed)
        row.append(self.dd_brightness)
        card.append(row)

        self.power_switches = {}
        for prop, label in POWER_SWITCHES:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.append(Gtk.Label(label=label, xalign=0, hexpand=True))
            switch = Gtk.Switch(valign=Gtk.Align.CENTER)
            switch.connect("notify::active", self.on_power_switch_changed, prop)
            row.append(switch)
            card.append(row)
            self.power_switches[prop] = switch

        self.anime_proxy = None
        self.syncing_settings = False  # True while widgets are updated from asusd
        self.settings_card = card
        card.set_sensitive(False)
        return card

    def connect_asusd(self):
        Gio.DBusProxy.new_for_bus(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
            ASUSD_NAME, ANIME_PATH, ANIME_IFACE, None, self.on_asusd_proxy_ready
        )

    def on_asusd_proxy_ready(self, source, result):
        try:
            self.anime_proxy = Gio.DBusProxy.new_for_bus_finish(result)
        except GLib.Error as e:
            self.lbl_settings_note.set_text(f"Unavailable: {e.message}")
            return
        # Picks up changes made elsewhere too (asusctl, a restarted asusd)
        self.anime_proxy.connect("g-properties-changed", lambda *args: self.sync_settings())
        self.anime_proxy.connect("notify::g-name-owner", lambda *args: self.sync_settings())
        self.sync_settings()

    def sync_settings(self):
        """Show asusd's current values; disable the card if asusd isn't running."""
        proxy = self.anime_proxy
        brightness = proxy.get_cached_property("Brightness") if proxy else None
        if brightness is None:
            self.settings_card.set_sensitive(False)
            self.lbl_settings_note.set_text("asusd is not running")
            return
        self.syncing_settings = True
        self.dd_brightness.set_selected(min(brightness.unpack(), len(BRIGHTNESS_LEVELS) - 1))
        for prop, switch in self.power_switches.items():
            value = proxy.get_cached_property(prop)
            if value is not None:
                switch.set_active(value.unpack())
        self.syncing_settings = False
        self.settings_card.set_sensitive(True)
        self.lbl_settings_note.set_text("")

    def on_brightness_changed(self, dropdown, pspec):
        if not self.syncing_settings:
            self.set_anime_property("Brightness", GLib.Variant("u", dropdown.get_selected()))

    def on_power_switch_changed(self, switch, pspec, prop):
        if not self.syncing_settings:
            self.set_anime_property(prop, GLib.Variant("b", switch.get_active()))

    def set_anime_property(self, prop, value):
        def done(proxy, result):
            try:
                proxy.call_finish(result)
            except GLib.Error as e:
                self.set_status(f"Couldn't change {prop}: {e.message}", "status-error")
                self.sync_settings()  # put the control back to asusd's real value
        self.anime_proxy.call(
            "org.freedesktop.DBus.Properties.Set",
            GLib.Variant("(ssv)", (ANIME_IFACE, prop, value)),
            Gio.DBusCallFlags.NONE, -1, None, done
        )

    def set_status(self, text, css_class):
        self.lbl_status.set_text(text)
        self.lbl_status.remove_css_class("status-success")
        self.lbl_status.remove_css_class("status-error")
        self.lbl_status.remove_css_class("status-info")
        self.lbl_status.add_css_class(css_class)

    def on_window_destroy(self, window):
        if self.gif_player:
            self.gif_player.stop()
        GLib.source_remove(self.tick_id)

if __name__ == "__main__":
    app = AniMeMatrixApp()
    sys.exit(app.run(sys.argv))
